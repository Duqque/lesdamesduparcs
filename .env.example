# Aucune variable n'est requise : le compte du créateur (contact@quentinduquenne.fr) est fourni avec le code
# et la clé de session est générée automatiquement (.data/auth-secret). Tout ce qui suit est facultatif.
# AUTH_SECRET=              # clé de session (24 caractères min.) ; à défaut, générée et conservée dans .data/
# SUPERADMIN_EMAIL=         # remplace le compte du créateur intégré
# SUPERADMIN_PASSWORD=      # 10 caractères minimum ; stocké uniquement sous forme hachée
# SUPERADMIN_NAME=          # ex. Prénom Nom
# DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/nomdelabase   # MySQL / MariaDB ; @ dans le mot de passe = %40. Sans elle : fichiers .data/
# RESEND_API_KEY=           # envoi des e-mails (campagnes, automatisations)
# CRON_SECRET=              # protège POST /api/cron/tick (rappels planifiés)
# SESSION_INSECURE_COOKIE=1  # uniquement pour tester `next start` en http local
# Paiement en ligne (HelloAsso, espace HelloAsso > Intégrations et API) :
# HELLOASSO_CLIENT_ID=
# HELLOASSO_CLIENT_SECRET=
# HELLOASSO_ORG_SLUG=       # identifiant de l'association dans son adresse HelloAsso
# HELLOASSO_SANDBOX=1       # environnement de test HelloAsso
# HELLOASSO_WEBHOOK_SECRET= # jeton (16 caractères min.) placé dans l'adresse de notification : /api/webhooks/helloasso?k=<jeton>
# HELLOASSO_SIGNATURE_KEY=  # facultatif : clé de signature des notifications (en-tête x-ha-signature)
# TRUSTED_PROXY_HOPS=1      # nombre de relais de confiance devant le site (adresse IP réelle des visiteurs)
NEXT_PUBLIC_SITE_URL=        # ex. https://www.lesdamesduparc.fr (adresses de retour du paiement, en https)
