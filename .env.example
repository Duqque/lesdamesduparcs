# Aucune variable n'est requise pour parcourir le site.
# Authentification et inscriptions (voir README) :
AUTH_SECRET=                 # chaîne aléatoire de 32 caractères minimum (openssl rand -hex 32)
SUPERADMIN_EMAIL=           # super administratrice, créée au premier lancement (rôle avec tous les accès)
SUPERADMIN_PASSWORD=        # 10 caractères minimum ; stocké uniquement sous forme hachée
SUPERADMIN_NAME=            # ex. Prénom Nom
# DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/nomdelabase   # MySQL / MariaDB ; @ dans le mot de passe = %40. Sans elle : fichiers .data/
# RESEND_API_KEY=           # envoi des e-mails (campagnes, automatisations)
# CRON_SECRET=              # protège POST /api/cron/tick (rappels planifiés)
# SESSION_INSECURE_COOKIE=1  # uniquement pour tester `next start` en http local
# Paiement (Stripe Checkout) :
# STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=        # ex. https://www.lesdamesduparc.fr (adresses de retour Stripe)
